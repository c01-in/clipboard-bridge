<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClipboardBridge</AssemblyName>
    <ApplicationIcon>Assets/ClipboardBridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Common/Common.csproj"/>
    <PackageReference Include="QRCoder" Version="1.6.0"/>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" PrivateAssets="all"/>
    <EmbeddedResource Include="Assets/ClipboardBridge.ico" LogicalName="ClipboardBridge.App.ico"/>
    <EmbeddedResource Include="Assets/ClipboardBridge-Paused.ico" LogicalName="ClipboardBridge.Paused.ico"/>
  </ItemGroup>
</Project>
